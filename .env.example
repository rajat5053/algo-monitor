# =============================================================================
# Algo Monitor — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Upstox ---
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_ACCESS_TOKEN=your-upstox-access-token

# --- Upstox Automated 2FA Login (Option 1) ---
UPSTOX_USERNAME=your-registered-mobile-number
UPSTOX_USER_PIN=your-6-digit-pin
UPSTOX_TOTP_KEY=your-authenticator-totp-secret-key
UPSTOX_REDIRECT_URI=http://127.0.0.1:8501/api/upstox/callback

# --- Delta Exchange India ---
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret

# --- Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- LLM (optional, for signal summaries) ---
# Supported: openai, gemini, none
LLM_PROVIDER=none
LLM_API_KEY=your-llm-api-key

# --- Application ---
# Database path (default: ./algo_monitor.db)
DATABASE_PATH=./algo_monitor.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Dashboard host and port
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# Paper trading simulated starting balance (INR)
PAPER_TRADING_BALANCE=1000000

# Maximum simultaneous paper positions
MAX_POSITIONS=5

# Risk per trade as fraction of balance (e.g., 0.02 = 2%)
RISK_PER_TRADE=0.02

# Maximum daily loss as fraction of balance (circuit breaker)
MAX_DAILY_LOSS=0.05

# Minimum reward-to-risk ratio
MIN_REWARD_RISK=1.5
