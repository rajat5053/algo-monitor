# =============================================================================
# Algo Monitor — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Upstox ---
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_ACCESS_TOKEN=your-upstox-access-token

# --- Upstox Automated 2FA Login (Option 1) ---
UPSTOX_USERNAME=your-registered-mobile-number
UPSTOX_USER_PIN=your-6-digit-pin
UPSTOX_TOTP_KEY=your-authenticator-totp-secret-key
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback

# --- Delta Exchange India ---
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret

# --- Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- LLM (optional, for signal summaries) ---
LLM_PROVIDER=none
LLM_API_KEY=your-llm-api-key

# --- Application ---
DATABASE_PATH=./algo_monitor.db
LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# --- Paper Trading Capital & Position Sizing ---
PAPER_TRADING_BALANCE=20000
INDIAN_MARKET_CAPITAL=20000
MAX_POSITIONS=3
RISK_PER_TRADE=0.005

# Per-market risk percentages (fraction of account equity)
INDIAN_CASH_RISK_PER_TRADE=0.005
INDIAN_FUTURES_RISK_PER_TRADE=0.005
CRYPTO_RISK_PER_TRADE=0.003
GOLD_RISK_PER_TRADE=0.0025

# Drawdown and circuit breaker limits
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.04
MAX_PEAK_DRAWDOWN=0.08
MAX_AGGREGATE_OPEN_RISK=0.01
MIN_REWARD_RISK=1.5

# Leverage and capital limits
MAX_LEVERAGE=1.0
MAX_CAPITAL_PER_TRADE_PCT=0.25
USD_INR_RATE=85.0

# --- Advanced Exit & Profit Protection ---
TRAILING_STOP_MODE=atr
ENABLE_BREAKEVEN_PROTECTION=True
BREAKEVEN_TRIGGER_R=0.75
BREAKEVEN_BUFFER_PCT=0.0
