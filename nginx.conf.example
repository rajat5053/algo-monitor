# Nginx Reverse Proxy Configuration for Algo Monitor
# Place in /etc/nginx/sites-available/algo-monitor and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name your_domain_or_vps_ip;

    # Optional: Password protection so public internet cannot tamper with your trading platform
    # Create with: sudo htpasswd -c /etc/nginx/.htpasswd myusername
    auth_basic "Algo Monitor Terminal";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Max upload size if needed
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        # WebSocket headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long polling / stream
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
